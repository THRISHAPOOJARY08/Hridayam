# ROUTELESS: THE LAST MILE — Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=routeless-rural-mobility-super-secret-jwt-key-2026-change-in-production

# Database
DB_PATH=./data/routeless.db

# CORS
CORS_ORIGIN=*

# --- AI Assistant (Optional) ---
# Leave empty to use the built-in rule-based NLP (fully functional, no key needed)
# Set to use an external AI model (OpenAI, Google Gemini, etc.)
GEMINI_API_KEY=
# AI_API_KEY=
# AI_MODEL=gemini-pro
# AI_BASE_URL=https://generativelanguage.googleapis.com

# --- Google OAuth (Optional) ---
# Required only for Google Sign-In button
# Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Email (Optional) ---
# Required for real email verification and password reset
# Configure SMTP credentials to enable email features
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@routeless.ai

# --- Speech Provider ---
# 'browser_native' = use Web Speech API (default, no config needed)
# 'google_tts'     = use Google Text-to-Speech (requires API key)
SPEECH_PROVIDER=browser_native

# --- Map Provider ---
# 'demo' = simulated coordinates, clearly labelled (default)
# 'openstreetmap' = no key needed, free
MAP_PROVIDER=demo
# GOOGLE_MAPS_API_KEY=
